NODE_ENV=production
AI_DM_HOST=127.0.0.1
AI_DM_PORT=3940
AI_DM_RUNTIME_ROOT=C:\dev\FoundryVtt\.runtime
AI_DM_WORLDS_ROOT=C:\dev\FoundryVtt\Data\Data\worlds
FOUNDRY_LOCAL_API_URL=http://127.0.0.1:3939
# Supplied in memory by normal Foundry startup from the Local API's own credential.
# Leave empty; never expose or copy this value to a browser.
FOUNDRY_LOCAL_API_KEY=
# Default route: Continue with ChatGPT in the GM panel, then choose an eligible model.
# Authorization stays server-side. A streamed request must verify provider eligibility.
# Optional API-key route: set auth=api-key and enable the explicit fallback below.
AI_DM_ENABLE_API_KEY_FALLBACK=false
OPENAI_API_KEY=
# Explicitly select api-key for ChatKit to bypass retained legacy world authorization.
# This does not alter or delete that authorization or change existing MCP behavior.
AI_DM_CHATKIT_AUTH=existing
# For API-key mode set an available Responses model. In existing mode this is
# only a preference among the eligible models discovered after GM sign-in.
OPENAI_MODEL=
# Python custom ChatKit service is started by the Node companion automatically.
# Defaults to chatkit-server/.venv/Scripts/python.exe (Windows) or .venv/bin/python.
AI_DM_CHATKIT_PYTHON=
AI_DM_CHATKIT_PORT=3941
# Defaults to AI_DM_RUNTIME_ROOT/ai-dungeon-master/chatkit.sqlite.
AI_DM_CHATKIT_DATABASE_PATH=
# Auto-provisioned into the ignored server/.env on first normal startup so encrypted
# ChatGPT authorization survives restart. Never expose it to a browser or Git.
AI_DM_SIGNING_KEY=
# AI_DM_FOUNDRY_BROKER_SECRET is generated by Foundry startup for its process tree.
# Do not add it here.

# External AI Dungeon Master wake webhook.
# These variables are read by the foundry-local-api process, because that process
# owns the movement queue and performs the POST. Copy them into
# foundry-local-api/server/.env (or export them before starting Foundry).
# Leave the URL empty to stay off. Never commit a real secret.
# AI_DM_WAKE_WEBHOOK_URL=https://your-dm-host.example/wake
# AI_DM_WAKE_WEBHOOK_SECRET=
# Header name. Default Authorization.
# AI_DM_WAKE_WEBHOOK_HEADER=Authorization
# Prefix before the secret. Default Bearer, which sends "Bearer <secret>".
# Set this empty to send the secret as the entire header value (for X-Api-Key and similar).
# AI_DM_WAKE_WEBHOOK_SCHEME=Bearer
# Quiet window per token so a drag becomes one event. Default 4000. Range 0-30000.
# AI_DM_WAKE_DEBOUNCE_MS=4000
# Skip GM-authored moves and GM chat. Default true.
# AI_DM_WAKE_PLAYERS_ONLY=true
# Post movement only when it crosses a room Region. Default false.
# AI_DM_WAKE_ROOM_CROSSINGS_ONLY=false
# Also POST chat messages and combat turn changes. Default false.
# AI_DM_WAKE_CHAT=false
# AI_DM_WAKE_COMBAT_TURNS=false
