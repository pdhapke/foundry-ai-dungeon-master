{
  "name": "@foundry-ai-dungeon-master/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --import tsx --import ../scripts/test-events-core-register.mjs --test --test-concurrency=4 \"src/**/*.test.ts\"",
    "generate:docs": "tsx src/scripts/generate-docs.ts"
  },
  "dependencies": {
    "@foundry-ai-dungeon-master/shared": "*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "openai": "^6.0.0",
    "ws": "^8.21.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
