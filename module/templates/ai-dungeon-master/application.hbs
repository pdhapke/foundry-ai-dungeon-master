<div class="ai-dm-chatkit-shell">
  <p class="ai-dm-chatkit-status" role="status" aria-live="polite">{{status}}</p>
  {{#if isGm}}
    <section class="ai-dm-provider" aria-label="ChatGPT authorization">
      <p class="ai-dm-provider-status" role="status" aria-live="polite">{{providerStatus}}</p>
      <div class="ai-dm-chatkit-toolbar">
        <button type="button" data-action="chatGptSignIn">Continue with ChatGPT</button>
        <button type="button" data-action="chatGptRefresh">Refresh status</button>
        <button type="button" data-action="chatGptSignOut">Sign out</button>
      </div>
      <label>ChatGPT model
        <select data-chatgpt-model aria-label="Eligible ChatGPT model"></select></label>
    </section>
    <div class="ai-dm-chatkit-toolbar">
      <button type="button" data-action="contextResponse">Describe current game context</button>
      <button type="button" data-action="cancelResponse">Cancel response</button>
    </div>
    <p class="ai-dm-context-notice">The context button sends the scene name and ID, selected
      actor/token IDs, target IDs, and combat round/turn. No journal or document text is sent.</p>
    <div class="ai-dm-chatkit-mount"></div>
  {{/if}}
</div>