{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Dungeon Master local HTTP API",
    "version": "0.1.0",
    "description": "Loopback-only health and ChatGPT sign-in callback endpoints. Foundry-authenticated run traffic uses the WebSocket protocol."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3940"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Degraded"
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "completeChatGptSignIn",
        "description": "Completes the local ChatGPT sign-in redirect and returns to Foundry.",
        "responses": {
          "200": {
            "description": "ChatGPT sign-in completed"
          },
          "400": {
            "description": "Sign-in failed or expired"
          }
        }
      }
    }
  }
}
