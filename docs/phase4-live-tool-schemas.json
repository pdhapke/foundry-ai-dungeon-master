  {
    "name": "foundry_attack_sequence_confirmed",
    "description": "Bounded explicit GM-authorized attack list, durable per-step roll/apply evidence and clean deadline continuation. No inferred Multiattack entitlement. Reactions and uncertainty need manual reconciliation. Budget is soft between native stages.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "attack-sequence-v1"
        },
        "worldId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "userId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "origin": {
          "type": "string",
          "const": "ai-dm"
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "execute"
                },
                "steps": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "stepId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,128}$"
                      },
                      "attack": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "roll"
                          },
                          "sceneId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "attackerTokenId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "actorId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "itemId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "activityId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "targetTokenId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "advantage": {
                            "type": "string",
                            "enum": [
                              "normal",
                              "advantage",
                              "disadvantage"
                            ]
                          },
                          "attackMode": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "ammunitionId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          },
                          "abilityId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{1,128}$"
                          }
                        },
                        "required": [
                          "mode",
                          "sceneId",
                          "attackerTokenId",
                          "actorId",
                          "itemId",
                          "activityId",
                          "targetTokenId",
                          "advantage"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "stepId",
                      "attack"
                    ],
                    "additionalProperties": false
                  }
                },
                "maxDurationMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 8000
                }
              },
              "required": [
                "mode",
                "steps",
                "maxDurationMs"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "resume"
                },
                "priorSequenceRequestId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "continuationId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "maxDurationMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 8000
                }
              },
              "required": [
                "mode",
                "priorSequenceRequestId",
                "continuationId",
                "maxDurationMs"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "worldId",
        "userId",
        "requestId",
        "correlationId",
        "origin",
        "action"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "dtt_get_status",
    "description": "Convenience composite read for the digital-tabletops integration: whether the module is active, whether a Foundry user named \"TV\" (case-insensitive, matching dtt.js's own check) exists and is currently online, and the module's four current world settings (namespace \"digital-tabletops\": hideUI, lockPan, display-width, port-number — also individually reachable via the generic GET/PUT /api/settings/digital-tabletops/:key endpoints). Call this before dtt_pan_battlemap/dtt_scale_battlemap_to_physical to confirm a display is actually connected.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
