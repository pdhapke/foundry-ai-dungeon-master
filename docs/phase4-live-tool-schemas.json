  {
    "name": "foundry_reload_client",
    "description": "Schedules a browser-page reload on one connected, opted-in Foundry client after returning an identity-bound acknowledgement. Success confirms scheduling only; callers must verify reconnection and re-enroll non-GM lanes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "correlationId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
        },
        "minimumModuleVersion": {
          "type": "string",
          "maxLength": 32
        },
        "delayMs": {
          "default": 1000,
          "type": "integer",
          "minimum": 500,
          "maximum": 5000
        }
      },
      "required": [
        "correlationId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
